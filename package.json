{
  "name": "dsh-aqua-theme",
  "version": "2.1.0",
  "description": "Aqua — 玻璃质感主题 for DeepSeek Harness：磨砂玻璃面板、粒子鲸鱼、鱼群、网格光点、光标辉光，支持渐变或自定义壁纸背景。",
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "theme",
    "glassmorphism",
    "aqua",
    "wallpaper"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thexiaohu/dsh-aqua-theme.git"
  },
  "homepage": "https://github.com/thexiaohu/dsh-aqua-theme#readme",
  "bugs": {
    "url": "https://github.com/thexiaohu/dsh-aqua-theme/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.module.css"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=22.15"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "react": "^18.2.0"
  },
  "license": "AGPL-3.0"
}
